        "bookingUrl": "https://www.booking.com/hotel/id/flores-passport-house.fr.html?aid=304142&label=gen173nr-10CAQoggJCC3NlYXJjaF9lbmRlSA1YBGhNiAEBmAEzuAEXyAEM2AED6AEB-AEBiAIBqAIBuALrw7TPBsACAdICJGVkN2VlY2I1LThhNDgtNGYxZS04MWYyLWVkYTJhZTI2YWY1N9gCAeACAQ&ucfs=1&arphpl=1&checkin=2026-07-15&checkout=2026-07-16&group_adults=2&req_adults=2&no_rooms=1&group_children=0&req_children=0&hpos=1&hapos=1&sr_order=popularity&nflt=review_score%3D90&srpvid=9af88ef57afc00c0&srepoch=1777148398&all_sr_blocks=558967903_244844216_2_1_0&highlighted_blocks=558967903_244844216_2_1_0&matching_block_id=558967903_244844216_2_1_0&sr_pri_blocks=558967903_244844216_2_1_0__66500000&from=searchresults",
