        "bookingUrl": "https://www.booking.com/hotel/be/huis-met-zonneterras-tuin-en-panoramisch-uitzicht.fr.html?aid=304142&label=gen173nr-10CAQoggJCFXNlYXJjaF9zb2hpZXIgYmVsZ2l1bUgNWARoTYgBAZgBM7gBF8gBDNgBA-gBAfgBAYgCAagCAbgCncO60QbAAgHSAiRiNDJmMDY2Zi1hN2IzLTQwZmEtYTMzYi1lMjZlNzViOWFiYzPYAgHgAgE&ucfs=1&arphpl=1&checkin=2026-07-15&checkout=2026-07-16&group_adults=2&req_adults=2&no_rooms=1&group_children=0&req_children=0&hpos=1&hapos=1&sr_order=distance_from_search&nflt=review_score%3D70&srpvid=6797594e2b6b0246&srepoch=1781440927&all_sr_blocks=933778001_424425393_6_0_0&highlighted_blocks=933778001_424425393_6_0_0&matching_block_id=933778001_424425393_6_0_0&sr_pri_blocks=933778001_424425393_6_0_0__24000&from=searchresults",
